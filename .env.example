# ─── Supabase (Database) ───
# Create a free project at https://supabase.com
# Then run the SQL migrations in your Supabase SQL editor:
#   1. pricing_data table (see src/app/api/pricing/seed/route.ts)
#   2. audits table (see src/app/api/report/route.ts)
#   3. leads table
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Anthropic (AI Summary) ───
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ─── Resend (Email) ───
# Free tier: 100 emails/day at https://resend.com
RESEND_API_KEY=re_your-resend-key

# ─── Pricing Seed Secret ───
# Used to protect POST /api/pricing/seed from public access
# Seed the DB: curl -X POST http://localhost:3000/api/pricing/seed -H "x-seed-secret: capexray-seed"
SEED_SECRET=capexray-seed

# ─── Optional ───
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
